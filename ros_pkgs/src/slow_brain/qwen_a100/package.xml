<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qwen_a100</name>
  <version>0.0.0</version>
  <description>Slow Brain grounding: Qwen VLM on the A100 via vLLM. Turns an
  instruction plus an EE camera frame into labeled detections with boxes and a
  structured destination spec.</description>
  <maintainer email="jaewonheo1101@gmail.com">Jaewon Heo</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>

  <!-- slow_brain.launch.py includes these; not build deps, but rosdep and
       launch-time resolution need them declared. -->
  <exec_depend>sam_a100</exec_depend>
  <exec_depend>mask_projection_pkg</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
